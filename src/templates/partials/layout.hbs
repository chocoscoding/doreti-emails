{{!--
  The shell every email renders inside: head, logo, the template's body, footer.

  Usage:  {{#> layout title="Order confirmed"}} …body… {{/layout}}

  Styled like the Doreti storefront: a white card outlined in black on the store's grey, a lime
  bar across the top, the logo above a black rule, Inter Tight (where the mail app loads web
  fonts; the system sans otherwise), black text and underlined black links. Text styles are set
  once on the content cell and inherited, so a template only writes <h1>, <p> and <strong>. The
  <style> block is a refinement; clients that strip it still get readable, correctly coloured
  text from the inline styles.

  Dark mode: `.ink` / `.muted` / `.rule` / `.bg` / `.surface` / `.panel` / `.btn-cell` are the only
  things recoloured. Any element with an inline near-black colour must carry `.ink`
  (scripts/preview.ts checks this).
--}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>{{title}}</title>
  <!--[if !mso]><!-->
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!--<![endif]-->
  <style>
    body { margin: 0; padding: 0; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table { border-collapse: collapse; }
    img { border: 0; outline: none; line-height: 100%; }
    h1 { margin: 0 0 14px 0; font-size: 26px; line-height: 32px; font-weight: 600; letter-spacing: -0.4px; }
    p { margin: 0 0 14px 0; }
    a { color: #000000; text-decoration: underline; }
    @media only screen and (max-width: 600px) {
      .pad { padding-left: 20px !important; padding-right: 20px !important; }
    }
    @media (prefers-color-scheme: dark) {
      .bg { background-color: #000000 !important; }
      .surface { background-color: #141414 !important; border-color: #3a3a3a !important; }
      .panel { background-color: #1f1f1f !important; border-color: #f2f2f2 !important; }
      .ink, h1, strong { color: #f2f2f2 !important; }
      .muted { color: #b4b4b4 !important; }
      .rule { border-color: #3a3a3a !important; }
      a { color: #f2f2f2 !important; }
      .btn-cell { background-color: #f2f2f2 !important; }
      a.btn { color: #000000 !important; }
    }
  </style>
</head>
<body class="bg" style="margin:0; padding:0; background-color:#f2f2f2;">
  {{!-- Inbox preview text; the trailing entities stop clients pulling body copy in after it. --}}
  <div style="display:none; max-height:0; max-width:0; overflow:hidden; opacity:0; font-size:1px; line-height:1px;">
    {{preheader}}&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
  </div>

  <table class="bg" role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f2f2f2;">
    <tr>
      <td align="center" style="padding:32px 12px;">
        <table class="surface" role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%; max-width:600px; background-color:#ffffff; border:1px solid #000000;">
          {{!-- Lime bar: the store's accent (its newsletter band and announcement strip) --}}
          <tr>
            <td height="6" style="height:6px; line-height:6px; font-size:0; background-color:#c5fa1f;">&nbsp;</td>
          </tr>

          <tr>
            <td class="pad rule" style="padding:24px 32px; border-bottom:1px solid #000000;">
              <a href="{{links.storefront}}" style="text-decoration:none;">
                {{#if brand.logoUrl}}
                <img src="{{emailImage brand.logoUrl}}" alt="{{brand.storeName}}" width="132" style="display:block; width:132px; max-width:132px; height:auto;">
                {{else}}
                <span class="ink" style="font-family:'Inter Tight', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:24px; line-height:28px; font-weight:700; letter-spacing:-0.5px; color:#000000;">{{brand.storeName}}</span>
                {{/if}}
              </a>
            </td>
          </tr>

          <tr>
            <td class="ink pad" style="padding:32px 32px 12px 32px; font-family:'Inter Tight', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:15px; line-height:24px; color:#000000;">
{{> @partial-block}}
            </td>
          </tr>

          <tr>
            <td class="muted rule pad" style="padding:20px 32px 24px 32px; border-top:1px solid #c8c8c8; font-family:'Inter Tight', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:12px; line-height:19px; color:#5a5a5a;">
              Questions? <a class="ink" href="mailto:{{brand.supportEmail}}" style="color:#000000; text-decoration:underline;">{{brand.supportEmail}}</a>{{#if brand.supportPhone}} &middot; {{brand.supportPhone}}{{/if}}<br>
              {{brand.companyName}}{{#if brand.addressLine}}, {{brand.addressLine}}{{/if}} &middot; &copy; {{brand.year}}
              {{#if isMarketing}}
              <br><a href="{{links.preferences}}" style="color:#5a5a5a; text-decoration:underline;">Email preferences</a>{{#if links.unsubscribe}} &middot; <a href="{{links.unsubscribe}}" style="color:#5a5a5a; text-decoration:underline;">Unsubscribe</a>{{/if}}
              {{/if}}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
