{{!--
  The email's one call to action, styled like the storefront's buttons: black, square, white label.
  Usage: {{> button href=orderStatusLink label="View your order"}}

  A background-coloured table cell around a padded link renders as a button in Outlook too,
  without a VML fallback. In dark mode it flips to a light button (.btn-cell / a.btn).
--}}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 24px 0;">
  <tr>
    <td class="btn-cell" bgcolor="#000000" style="background-color:#000000;">
      <a class="btn" href="{{href}}" style="display:inline-block; padding:14px 26px; font-size:15px; line-height:20px; font-weight:500; color:#ffffff; text-decoration:none;">{{label}}</a>
    </td>
  </tr>
</table>
